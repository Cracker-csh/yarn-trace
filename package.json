{
  "name": "yarntrace-workspace",
  "version": "1.0.0",
  "description": "YarnTrace — Yarn Inventory & Production Traceability System",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "lint:backend": "npm run lint --prefix backend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "test:backend": "npm test --prefix backend",
    "test": "npm run test:backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:studio": "npm run prisma:studio --prefix backend"
  },
  "keywords": [
    "textile",
    "yarn",
    "inventory",
    "traceability",
    "production",
    "nest",
    "nextjs",
    "prisma",
    "postgresql"
  ],
  "author": "YarnTrace Team",
  "license": "UNLICENSED"
}
