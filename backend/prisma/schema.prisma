// YarnTrace Prisma Schema
// PostgreSQL Database Schema for Yarn Inventory & Production Traceability System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum YarnType {
  GREY
  DYED
  COMBED
  CARDED
  OPEN_END
  COMPACT
  BLENDED
  SYNTHETIC
}

enum LotStatus {
  RECEIVED
  QUALITY_PENDING
  APPROVED
  IN_PRODUCTION
  EXHAUSTED
  QUARANTINED
  RETIRED
}

enum TransactionType {
  OPENING
  RECEIVED
  ISSUED
  RETURN
  RETURNED
  RETIRED
  SOLD
  CORRECTION
  ADJUSTMENT
  TRANSFER
}

enum TransactionStatus {
  DRAFT
  PENDING_APPROVAL
  COMPLETED
  CANCELLED
}

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum YarnAllocationStatus {
  ALLOCATED
  PARTIALLY_ISSUED
  FULLY_ISSUED
  CANCELLED
}

enum DyeingOrderStatus {
  DRAFT
  DISPATCHED
  IN_PROCESSING
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum DyeingMovementType {
  OUTWARD_DISPATCH
  INWARD_RECEIPT
  RETURN
}

enum POStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  IN_PRODUCTION
  PARTIALLY_DELIVERED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum DeliveryStatus {
  DRAFT
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PartyType {
  SUPPLIER
  CUSTOMER
  DYEING_MILL
  JOB_WORKER
  INTERNAL
}

// =============================================================================
// 1. IDENTITY & ACCESS CONTROL
// =============================================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phoneNumber  String?
  status       UserStatus @default(ACTIVE)
  refreshTokenHash String?

  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])

  userPermissions UserPermission[]
  auditLogs       AuditLog[]
  transactions    Transaction[]   @relation("UserTransactions")
  productionOrders    ProductionOrder[]   @relation("UserProductionOrders")
  allocations         YarnAllocation[]    @relation("UserAllocations")
  consumptionRecords  ConsumptionRecord[] @relation("UserConsumptions")
  productionReturns   ProductionReturn[]  @relation("UserReturns")
  productionOutputs   ProductionOutput[]  @relation("UserOutputs")

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isSystem    Boolean  @default(false)

  users           User[]
  rolePermissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  module      String
  description String?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  isGranted    Boolean    @default(true) // Explicit grant or override revoke

  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
}

// =============================================================================
// 2. YARN & LOT MASTER
// =============================================================================

model Yarn {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  type          YarnType @default(GREY)
  yarnCount     String   // e.g. "40s Ne", "30/1", "20/2"
  composition   String   // e.g. "100% Combed Cotton", "60/40 Poly Cotton"
  color         String?  // e.g. "Raw Natural", "Optic White"
  description   String?
  isActive      Boolean  @default(true)

  lots          Lot[]
  poRequirements PORequirement[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([yarnCount])
}

model Lot {
  id             String    @id @default(uuid())
  lotNumber      String    @unique
  yarnId         String?
  yarn           Yarn?     @relation(fields: [yarnId], references: [id])
  yarnCount      String?   // Yarn count text e.g. "1/10 KW"
  supplierId     String?
  supplier       Party?    @relation("SupplierLots", fields: [supplierId], references: [id])
  
  // Dyeing Parent/Child Lot lineage
  parentLotId    String?
  parentLot      Lot?      @relation("DyeingLotLineage", fields: [parentLotId], references: [id])
  childLots      Lot[]     @relation("DyeingLotLineage")
  
  initialBags    Int       @default(0)
  initialCones   Int       @default(0)
  initialWeightKg Decimal  @default(0) @db.Decimal(12, 4) // Initial received/opening net KG
  currentBags    Int       @default(0)
  currentWeightKg Decimal  @default(0) @db.Decimal(12, 4) // Aggregated current KG across locations
  
  status         LotStatus @default(RECEIVED)
  receivedDate   DateTime  @default(now())
  millLotNumber  String?   // Supplier's original lot number
  shadeCode      String?
  remarks        String?

  transactions        Transaction[]       @relation("LotTransactions")
  stockBalances       StockBalance[]
  transactionItems    TransactionItem[]
  yarnAllocations     YarnAllocation[]
  consumptionRecords  ConsumptionRecord[]
  productionReturns   ProductionReturn[]
  dyeingMovements     DyeingMovement[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([yarnId])
  @@index([yarnCount])
  @@index([supplierId])
  @@index([parentLotId])
  @@index([status])
  @@index([receivedDate])
  @@index([updatedAt])
  @@index([currentWeightKg])
}

// =============================================================================
// 3. INVENTORY & STOCK BALANCES
// =============================================================================

model StockLocation {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  type        String   // "WAREHOUSE", "SILO", "FLOOR_STAGE", "BAY"
  description String?
  isActive    Boolean  @default(true)

  stockBalances       StockBalance[]
  sourceTransactions  TransactionItem[] @relation("SourceLocation")
  targetTransactions  TransactionItem[] @relation("TargetLocation")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

}

model StockBalance {
  id           String        @id @default(uuid())
  lotId        String
  lot          Lot           @relation(fields: [lotId], references: [id], onDelete: Cascade)
  locationId   String
  location     StockLocation @relation(fields: [locationId], references: [id])
  
  quantityKg   Decimal       @db.Decimal(12, 4)
  bagsCount    Int           @default(0)
  conesCount   Int           @default(0)
  
  lastUpdated  DateTime      @default(now()) @updatedAt

  @@unique([lotId, locationId])
  @@index([lotId])
  @@index([locationId])
}

model Transaction {
  id                    String            @id @default(uuid())
  transactionNumber     String            @unique
  type                  TransactionType
  status                TransactionStatus @default(COMPLETED)
  transactionDate       DateTime          @default(now())
  
  // Core inventory transaction fields
  yarnCount             String?           // manual text input e.g. "1/10 KW"
  partyId               String?
  party                 Party?            @relation("PartyTransactions", fields: [partyId], references: [id])
  lotId                 String?
  lot                   Lot?              @relation("LotTransactions", fields: [lotId], references: [id])
  bags                  Int               @default(0)
  kilos                 Decimal           @default(0) @db.Decimal(12, 4)
  poNumber              String?
  poRequirementId       String?
  poRequirement         PORequirement?    @relation("RequirementTransactions", fields: [poRequirementId], references: [id])
  purpose               String?           // PILE, GROUND, WEFT, DYED, NPD, GENERAL
  
  // Reference & audit for RETURN and CORRECTION/REVERSAL
  referenceTransactionId String?
  referenceTransaction  Transaction?      @relation("TransactionReferences", fields: [referenceTransactionId], references: [id])
  referencedBy          Transaction[]     @relation("TransactionReferences")
  
  correctionReason      String?
  oldValue              Json?
  newValue              Json?
  notes                 String?           // Remarks
  referenceNumber       String?           // Invoice / Gate pass / Delivery Challan no.
  
  createdById           String?
  createdBy             User?             @relation("UserTransactions", fields: [createdById], references: [id])

  items                 TransactionItem[]
  allocations           YarnAllocation[]   @relation("AllocationTransaction")
  productionReturns     ProductionReturn[] @relation("ProductionReturnTransaction")

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([type])
  @@index([transactionDate])
  @@index([yarnCount])
  @@index([partyId])
  @@index([lotId])
  @@index([poNumber])
  @@index([referenceTransactionId])
  @@index([type, transactionDate])
  @@index([lotId, type])
  @@index([lotId, transactionDate])
  @@index([partyId, type])
  @@index([createdAt])
}

model TransactionItem {
  id                String         @id @default(uuid())
  transactionId     String
  transaction       Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  lotId             String
  lot               Lot            @relation(fields: [lotId], references: [id])
  
  sourceLocationId  String?
  sourceLocation    StockLocation? @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  targetLocationId  String?
  targetLocation    StockLocation? @relation("TargetLocation", fields: [targetLocationId], references: [id])

  quantityKg        Decimal        @db.Decimal(12, 4)
  grossWeightKg     Decimal?       @db.Decimal(12, 4)
  tareWeightKg      Decimal?       @db.Decimal(12, 4)
  bagsCount         Int            @default(0)
  conesCount        Int            @default(0)
  remarks           String?

  createdAt         DateTime       @default(now())

  @@index([transactionId])
  @@index([lotId])
}

// =============================================================================
// 4. PRODUCTION & CONSUMPTION
// =============================================================================

model ProductionTeam {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  department  String   // "SPINNING", "WARPING", "WEAVING", "KNITTING"
  teamLead    String?
  remarks     String?
  isActive    Boolean  @default(true)

  orders             ProductionOrder[]
  allocations        YarnAllocation[]
  consumptionRecords ConsumptionRecord[]
  returns            ProductionReturn[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department])
  @@index([isActive])
}

model ProductionOrder {
  id            String                @id @default(uuid())
  orderNumber   String                @unique
  status        ProductionOrderStatus @default(PLANNED)
  targetQuantity Decimal              @db.Decimal(12, 4)
  unit          String                @default("KG")
  priority      String                @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  purpose       String?               // "WEAVING", "WARPING", "KNITTING", "SAMPLING", etc.
  productName   String?
  productType   String?
  poNumber      String?
  
  partyId       String?
  party         Party?                @relation("PartyProductionOrders", fields: [partyId], references: [id])
  
  productionTeamId String?
  productionTeam   ProductionTeam?    @relation(fields: [productionTeamId], references: [id])
  
  startDate     DateTime?
  targetDate    DateTime?
  completedDate DateTime?
  remarks       String?
  
  createdById   String?
  createdBy     User?                 @relation("UserProductionOrders", fields: [createdById], references: [id])

  allocations        YarnAllocation[]
  consumptionRecords ConsumptionRecord[]
  returns            ProductionReturn[]
  outputs            ProductionOutput[]
  products           Product[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status])
  @@index([partyId])
  @@index([productionTeamId])
  @@index([poNumber])
  @@index([createdAt])
}

model YarnAllocation {
  id                String               @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder      @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionTeamId  String
  productionTeam    ProductionTeam       @relation(fields: [productionTeamId], references: [id])
  lotId             String
  lot               Lot                  @relation(fields: [lotId], references: [id])
  
  inventoryTransactionId String?
  inventoryTransaction   Transaction?    @relation("AllocationTransaction", fields: [inventoryTransactionId], references: [id])

  yarnCount         String?              // e.g. "1/10 KW"
  bags              Int                  @default(0)
  allocatedKg       Decimal              @db.Decimal(12, 4)
  issuedKg          Decimal              @default(0) @db.Decimal(12, 4)
  status            YarnAllocationStatus @default(ALLOCATED)
  allocatedDate     DateTime             @default(now())
  
  allocatedById     String?
  allocatedBy       User?                @relation("UserAllocations", fields: [allocatedById], references: [id])
  
  remarks           String?

  consumptionRecords ConsumptionRecord[]
  returns            ProductionReturn[]

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([productionOrderId])
  @@index([productionTeamId])
  @@index([lotId])
  @@index([lotId, productionOrderId])
  @@index([inventoryTransactionId])
  @@index([status])
}

model ConsumptionRecord {
  id                String          @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionTeamId  String
  productionTeam    ProductionTeam  @relation(fields: [productionTeamId], references: [id])
  lotId             String
  lot               Lot             @relation(fields: [lotId], references: [id])
  
  yarnAllocationId  String?
  yarnAllocation    YarnAllocation? @relation(fields: [yarnAllocationId], references: [id])

  yarnCount         String?
  bags              Int             @default(0)
  consumedKg        Decimal         @db.Decimal(12, 4)
  wasteKg           Decimal         @default(0) @db.Decimal(12, 4)
  wasteCategory     String?         // "FLY_WASTE", "HARD_WASTE", "DEFECTIVE", "FLOOR_SWEEPING", etc.
  netProducedKg     Decimal?        @db.Decimal(12, 4)
  purpose           String?
  consumptionDate   DateTime        @default(now())
  
  recordedById      String?
  recordedBy        User?           @relation("UserConsumptions", fields: [recordedById], references: [id])
  remarks           String?
  
  isCorrected            Boolean         @default(false)
  correctionReason       String?
  correctedById          String?
  originalConsumptionId  String?
  originalConsumption    ConsumptionRecord?  @relation("ConsumptionCorrections", fields: [originalConsumptionId], references: [id])
  correctionRecords      ConsumptionRecord[] @relation("ConsumptionCorrections")

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([productionOrderId])
  @@index([productionTeamId])
  @@index([lotId])
  @@index([lotId, productionOrderId])
  @@index([yarnAllocationId])
  @@index([consumptionDate])
  @@index([isCorrected])
}

model ProductionReturn {
  id                String          @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionTeamId  String
  productionTeam    ProductionTeam  @relation(fields: [productionTeamId], references: [id])
  lotId             String
  lot               Lot             @relation(fields: [lotId], references: [id])
  
  yarnAllocationId  String?
  yarnAllocation    YarnAllocation? @relation(fields: [yarnAllocationId], references: [id])

  inventoryTransactionId String?
  inventoryTransaction   Transaction?  @relation("ProductionReturnTransaction", fields: [inventoryTransactionId], references: [id])

  yarnCount         String?
  returnedKg        Decimal         @db.Decimal(12, 4)
  returnedBags      Int             @default(0)
  returnDate        DateTime        @default(now())
  reason            String?
  remarks           String?
  
  recordedById      String?
  recordedBy        User?           @relation("UserReturns", fields: [recordedById], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([productionOrderId])
  @@index([productionTeamId])
  @@index([lotId])
  @@index([yarnAllocationId])
  @@index([inventoryTransactionId])
  @@index([returnDate])
}

model ProductionOutput {
  id                String          @id @default(uuid())
  batchNumber       String?         @unique // e.g. "OUT-2026-0001"
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id])

  productName       String
  productCode       String?
  productType       String?         // "FABRIC_ROLL", "FINISHED_YARN", "MANUFACTURED_BATCH", "GARMENT"
  outputQuantityKg  Decimal         @db.Decimal(12, 4)
  unit              String          @default("KG")
  status            String?         @default("PRODUCED") // "PRODUCED", "READY", "DELIVERED", "CANCELLED"
  outputDate        DateTime        @default(now())
  remarks           String?
  
  recordedById      String?
  recordedBy        User?           @relation("UserOutputs", fields: [recordedById], references: [id])

  deliveries        Delivery[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([productionOrderId])
  @@index([productId])
  @@index([outputDate])
  @@index([status])
}

// =============================================================================
// 5. OUTPUT & DELIVERIES
// =============================================================================

model Product {
  id                String           @id @default(uuid())
  productCode       String           @unique
  name              String
  description       String?
  category          String?          // "FABRIC_ROLL", "FINISHED_YARN", "MANUFACTURED_BATCH", "GARMENT"
  
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  totalQuantityKg   Decimal          @db.Decimal(12, 4)
  availableKg       Decimal          @db.Decimal(12, 4)
  unit              String           @default("KG")
  status            String?          @default("READY") // "DRAFT", "PRODUCED", "READY", "DELIVERED", "CANCELLED"
  isActive          Boolean          @default(true)

  outputs           ProductionOutput[]
  deliveries        Delivery[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([category])
  @@index([productionOrderId])
}

model Delivery {
  id              String         @id @default(uuid())
  deliveryNumber  String         @unique
  partyId         String
  party           Party          @relation(fields: [partyId], references: [id])
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id])
  outputId        String?
  productionOutput ProductionOutput? @relation(fields: [outputId], references: [id])

  dispatchedKg    Decimal        @db.Decimal(12, 4)
  status          DeliveryStatus @default(DRAFT)
  dispatchDate    DateTime       @default(now())
  vehicleNumber   String?
  driverContact   String?
  lrNumber        String?        // Lorry receipt number
  remarks         String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([partyId])
  @@index([productId])
  @@index([outputId])
}

// =============================================================================
// 6. COMMERCIAL & DYEING
// =============================================================================

model Party {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  type          PartyType @default(CUSTOMER)
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstNumber     String?
  isActive      Boolean   @default(true)

  suppliedLots   Lot[]           @relation("SupplierLots")
  purchaseOrders PurchaseOrder[]
  deliveries     Delivery[]
  dyeingOrders   DyeingOrder[]
  transactions   Transaction[]   @relation("PartyTransactions")
  productionOrders ProductionOrder[] @relation("PartyProductionOrders")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([name])
}

model PurchaseOrder {
  id          String          @id @default(uuid())
  poNumber    String          @unique
  partyId     String
  party       Party           @relation(fields: [partyId], references: [id])
  status      POStatus        @default(CONFIRMED)
  orderDate   DateTime        @default(now())
  deliveryDue DateTime?
  totalAmount Decimal?        @db.Decimal(14, 2)
  remarks     String?

  requirements PORequirement[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([partyId])
}

model PORequirement {
  id              String         @id @default(uuid())
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  yarnId          String?
  yarn            Yarn?          @relation(fields: [yarnId], references: [id])
  yarnCount       String?        // Count e.g. "1/10 KW"
  quality         String?        // e.g. "Cotton", "PC", "Modal"
  size            String?        // e.g. "30x60", "30x30", "Medium"
  useFor          String?        // e.g. "Bath Towel", "Face Towel"
  purpose         String?        // PILE, GROUND, WEFT, DYED, NPD, GENERAL
  pcs             Int?           // Pieces count
  qty             Decimal?       @db.Decimal(12, 4) // Quantity
  poNumber        String?

  requiredKg      Decimal        @db.Decimal(12, 4)
  issuedKg        Decimal        @default(0) @db.Decimal(12, 4)
  notes           String?
  status          String?        @default("PENDING") // PENDING, PARTIAL, COMPLETED, N/A

  transactions    Transaction[]  @relation("RequirementTransactions")

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([purchaseOrderId])
  @@index([yarnId])
  @@index([yarnCount])
  @@index([purpose])
  @@index([poNumber])
  @@index([status])
}

model DyeingOrder {
  id          String            @id @default(uuid())
  orderNumber String            @unique
  dyeingMillId String
  dyeingMill  Party             @relation(fields: [dyeingMillId], references: [id])
  status      DyeingOrderStatus @default(DRAFT)
  targetShade String
  targetKg    Decimal           @db.Decimal(12, 4)
  orderDate   DateTime          @default(now())
  expectedDate DateTime?
  remarks     String?

  movements   DyeingMovement[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([dyeingMillId])
}

model DyeingMovement {
  id            String             @id @default(uuid())
  dyeingOrderId String
  dyeingOrder   DyeingOrder        @relation(fields: [dyeingOrderId], references: [id])
  lotId         String
  lot           Lot                @relation(fields: [lotId], references: [id])
  type          DyeingMovementType
  
  quantityKg    Decimal            @db.Decimal(12, 4)
  movementDate  DateTime           @default(now())
  challanNumber String?
  notes         String?

  createdAt     DateTime           @default(now())

  @@index([dyeingOrderId])
  @@index([lotId])
}

// =============================================================================
// 7. GOVERNANCE & AUDITING
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "CREATE", "UPDATE", "DELETE", "ISSUE_YARN", "LOGIN"
  module     String   // e.g. "INVENTORY", "AUTH", "PRODUCTION", "LOTS"
  entityType String   // e.g. "Lot", "Transaction", "User"
  entityId   String?  // Target record UUID
  oldValue   Json?    // Snapshot before mutation
  newValue   Json?    // Snapshot after mutation
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entityType])
  @@index([timestamp])
}
